{
  "name": "dsh-qqbot-bridge",
  "version": "0.1.0",
  "description": "DSH QQ 官方机器人桥接插件 —— 通过 QQ 单聊远程控制 DSH WebUI 已有工作区的会话",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "tsc && pnpm run build:client",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "test:quick": "vitest run",
    "probe:e11": "tsx scripts/probe-e11.ts",
    "probe:qq": "tsx scripts/probe-qq.ts",
    "clean": "rm -rf dist",
    "probe:e12a": "tsx scripts/probe-e12a.ts",
    "probe:e12b": "tsx scripts/probe-e12b.ts",
    "probe:webui-sync": "tsx scripts/probe-webui-sync.ts",
    "probe:session-list": "tsx scripts/probe-session-list.ts",
    "probe:e3": "tsx scripts/probe-e3-length.ts",
    "probe:first-message": "tsx scripts/probe-first-message.ts",
    "build:client": "tsx scripts/build-client.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiangsubei/dsh-qqbot-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Jiangsubei/dsh-qqbot-bridge/issues"
  },
  "homepage": "https://github.com/Jiangsubei/dsh-qqbot-bridge#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "qq-bot",
    "qq-official-bot",
    "cordis"
  ],
  "author": "Jiangsubei",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.5.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-app-boot": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-base": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-storage": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-json": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.1",
    "@deepseek-ai/dsh-base": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.1.5-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
